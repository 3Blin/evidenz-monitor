# Vorlage - kopieren nach .env und ausfuellen. .env gehoert NICHT ins Repository.

# --- Sammellauf und Tests (serverseitig) ---
DATABASE_URL=postgres://evidenz:PASSWORT@localhost:5432/evidenz
# 32 Bytes base64, erzeugen mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=
LOG_LEVEL=info

# Hinweis: BYOK_ENCRYPTION_KEY braucht seit ADR 0009 auch die Weboberflaeche
# (also auch Vercel). Sie verschluesselt damit die KI-Zugaenge der Nutzer,
# bevor sie in die Datenbank gehen. Bewusst OHNE NEXT_PUBLIC_-Vorsilbe: der
# Wert darf nie im Browser landen.

# --- Weboberflaeche (auch in Vercel als Umgebungsvariablen setzen) ---
# NEXT_PUBLIC_AUFTRAG ist nur die Vorauswahl. Alle als Demo freigegebenen
# Auftraege stehen in der Oberflaeche zur Auswahl (ADR 0009).
NEXT_PUBLIC_SUPABASE_URL=https://DEINPROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
NEXT_PUBLIC_AUFTRAG=00000000-0000-0000-0000-000000000000
